#!/usr/bin/env bash
# check-pack — verify the package packs EXACTLY the required files.
#
# Performs a real pack into a throwaway directory and diffs the result against
# the allow-list of scripts/template-files:
#   EXTRA    a file shipped but not required (a leak)
#   MISSING  a required file that did not get packed (would break the build)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/setup"
. "$(dirname "${BASH_SOURCE[0]}")/template-files"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

"$ROOT/scripts/pack" "$TMP" >/dev/null
pkg="$TMP/$PKG_NAME/$VERSION"
actual="$(cd "$pkg" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)"
expect="$(expected_files | LC_ALL=C sort -u)"
extra="$(LC_ALL=C comm -13 <(printf '%s\n' "$expect") <(printf '%s\n' "$actual"))"
missing="$(LC_ALL=C comm -23 <(printf '%s\n' "$expect") <(printf '%s\n' "$actual"))"

if [[ -z "$extra" && -z "$missing" ]]; then
  echo "✓ $PKG_NAME:$VERSION packs exactly its required files ($(printf '%s\n' "$actual" | wc -l | tr -d ' ') files)"
  du -sh "$pkg" | awk '{print "  bundle size: " $1}'
else
  echo "✗ $PKG_NAME:$VERSION"
  [[ -n "$extra" ]]   && printf '    EXTRA   (dangling): %s\n' $extra
  [[ -n "$missing" ]] && printf '    MISSING (required): %s\n' $missing
  exit 1
fi
