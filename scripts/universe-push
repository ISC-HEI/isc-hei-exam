#!/usr/bin/env bash
# Push the staged release branch to the fork and print the PR compare URL.
# The only networked write; it does NOT open the PR.
#   --force   refresh an already-open PR at the same version (universe-repush)
. "$(dirname "${BASH_SOURCE[0]}")/universe-common"

[[ -d "$CLONE_DIR/.git" ]] || { echo "No clone at $CLONE_DIR — run 'just universe-stage' first." >&2; exit 1; }
git -C "$CLONE_DIR" rev-parse --verify --quiet "$BRANCH" >/dev/null \
  || { echo "Branch '$BRANCH' not found — run 'just universe-stage' first." >&2; exit 1; }

if [[ "${1:-}" == "--force" ]]; then
  git -C "$CLONE_DIR" ls-remote --exit-code --heads origin "$BRANCH" >/dev/null 2>&1 \
    || { echo "'$BRANCH' is not on $FORK yet: there is no open PR to update, push normally first." >&2; exit 1; }
  echo "Force-pushing $BRANCH to $FORK (rewrites the open PR) ..."
  git -C "$CLONE_DIR" push --force origin "$BRANCH"
else
  echo "Pushing $BRANCH to $FORK ..."
  git -C "$CLONE_DIR" push -u origin "$BRANCH"
fi
echo
echo "Open the PR against $UPSTREAM (write the description yourself):"
echo "  https://github.com/$UPSTREAM/compare/main...${FORK/\//:}:${BRANCH}?expand=1"
