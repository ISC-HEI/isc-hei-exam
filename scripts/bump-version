#!/usr/bin/env bash
# Bump the package version everywhere it appears:
#   typst.toml, the `@preview/isc-hei-exam:X.Y.Z` imports of template/*.typ,
#   README.md and tests/.
#
#   scripts/bump-version            patch  0.1.0 → 0.1.1
#   scripts/bump-version minor      minor  0.1.1 → 0.2.0
#   scripts/bump-version 1.0.0      explicit
set -eu
. "$(dirname "${BASH_SOURCE[0]}")/setup"

usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
MODE="${1:-patch}"
IFS='.' read -r major minor patch <<< "$VERSION"
case "$MODE" in
  patch|--patch) NEW="$major.$minor.$((patch + 1))" ;;
  minor|--minor) NEW="$major.$((minor + 1)).0" ;;
  -h|--help|--*) usage ;;
  *) [[ "$MODE" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "not a version: $MODE" >&2; exit 1; }; NEW="$MODE" ;;
esac

echo "Current version : $VERSION"
echo "New version     : $NEW"
cd "$ROOT"
perl -pi -e "s/^version = \".*\"/version = \"$NEW\"/" typst.toml
echo "  updated typst.toml"
while IFS= read -r f; do
  if grep -q "@preview/$PKG_NAME:[0-9]*\.[0-9]*\.[0-9]*" "$f"; then
    perl -pi -e "s|\@preview/$PKG_NAME:[0-9]+\.[0-9]+\.[0-9]+|\@preview/$PKG_NAME:$NEW|g" "$f"
    echo "  updated $f"
  fi
done < <(find template tests README.md -type f \( -name '*.typ' -o -name '*.md' -o -name '*.sh' -o -name '*.txt' \) 2>/dev/null)
echo "Done. Re-run 'just dev' to relink @preview/$PKG_NAME:$NEW."
